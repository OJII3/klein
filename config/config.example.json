{
  "$schema": "./config.schema.json",
  "version": 1,
  "profile": "klein",
  "owner": {
    "discord": {
      "userId": "456789012345678901"
    }
  },
  "permissions": {
    "tools": {
      "default": "allow",
      "overrides": {}
    },
    "mcp": {
      "default": "owner",
      "servers": {
        "obsidian": "owner",
        "docs": "allow"
      }
    }
  },
  "llm": {
    "provider": "opencode-go",
    "model": "deepseek-v4.1-flash",
    "thinkingLevel": "high",
    "contextWindowRatio": 0.5,
    "image": {
      "provider": "opencode-go",
      "model": "deepseek-v4-flash-vision-exp"
    }
  },
  "runtime": {
    "agentDir": ".runtime/pi",
    "logDir": ".runtime/logs"
  },
  "discord": {
    "access": {
      "default": "deny",
      "directMessages": "allow"
    }
  },
  "features": {
    "sharedMemory": {
      "enabled": false,
      "directory": ".runtime/memory",
      "llm": {
        "provider": "opencode-go",
        "model": "qwen3.8-flash",
        "thinkingLevel": "low"
      },
      "idleSeconds": 180,
      "maxBatchAgeSeconds": 1800,
      "maxBatchMessages": 32
    },
    "userMemory": {
      "enabled": false,
      "directory": ".runtime/pi/user-memory",
      "llm": {
        "provider": "opencode-go",
        "model": "qwen3.8-flash",
        "thinkingLevel": "low"
      }
    },
    "proactivity": {
      "enabled": false,
      "preferencesDirectory": ".runtime/pi/proactive/preferences",
      "followUpDirectory": ".runtime/pi/proactive/follow-ups",
      "signalDirectory": ".runtime/pi/proactive/signals",
      "defaultMode": "attach",
      "quietHours": {
        "start": "23:00",
        "end": "08:00"
      },
      "digestAt": "09:00",
      "maxPerDay": 3,
      "publicChannels": false,
      "promiseGuard": "log"
    },
    "minecraft": {
      "enabled": false
    },
    "webui": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 4310,
      "cloudflared": {
        "enabled": false
      }
    },
    "tts": {
      "enabled": false,
      "serverUrl": "http://100.64.0.10:5000"
    },
    "voiceChat": {
      "enabled": false,
      "asrServerUrl": "ws://100.64.0.11:8000",
      "language": "ja",
      "llm": {
        "provider": "opencode-go",
        "model": "qwen3.8-flash",
        "thinkingLevel": "low"
      },
      "reactions": {
        "provider": "cloudflare-workers-ai",
        "model": "@cf/cloudflare/clef-flash",
        "presetsFile": "config/voice-presets.example.json"
      }
    }
  }
}
