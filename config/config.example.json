{
  "$schema": "./config.schema.json",
  "version": 1,
  "profile": "klein",
  "owner": {
    "discord": {
      "userId": "456789012345678901"
    }
  },
  "permissions": {
    "tools": {
      "default": "allow",
      "overrides": {}
    },
    "mcp": {
      "default": "owner",
      "servers": {
        "obsidian": "owner",
        "docs": "allow"
      }
    }
  },
  "llm": {
    "provider": "opencode-go",
    "model": "deepseek-v4.1-flash",
    "thinkingLevel": "high",
    "contextWindowRatio": 0.5,
    "compaction": {
      "backgroundTokens": 16384
    },
    "image": {
      "provider": "opencode-go",
      "model": "deepseek-v4-flash-vision-exp"
    }
  },
  "runtime": {
    "agentDir": ".runtime/pi",
    "logDir": ".runtime/logs"
  },
  "discord": {
    "access": {
      "default": "deny",
      "directMessages": "allow",
      "guilds": {
        "123456789012345678": {
          "access": "allow",
          "channels": {
            "234567890123456789": {
              "access": "deny",
              "threads": {
                "345678901234567890": {
                  "access": "allow"
                }
              }
            },
            "456789012345678901": {
              "access": "owner"
            }
          }
        }
      }
    }
  },
  "features": {
    "memory": {
      "enabled": false,
      "filePath": ".runtime/memory/{guildId}/MEMORY.json",
      "llm": {
        "provider": "opencode-go",
        "model": "qwen3.8-flash",
        "thinkingLevel": "low"
      },
      "idleSeconds": 180,
      "maxBatchAgeSeconds": 1800,
      "maxBatchMessages": 32
    },
    "minecraft": {
      "enabled": false
    },
    "webui": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 4310
    },
    "tts": {
      "enabled": false,
      "serverUrl": "http://100.64.0.10:5000"
    },
    "voiceChat": {
      "enabled": false,
      "asrServerUrl": "ws://100.64.0.11:8000",
      "language": "ja",
      "llm": {
        "provider": "opencode-go",
        "model": "qwen3.8-flash",
        "thinkingLevel": "low"
      },
      "reactions": {
        "provider": "cloudflare-workers-ai",
        "model": "@cf/cloudflare/clef-flash",
        "presetsFile": "config/voice-presets.example.json"
      }
    }
  }
}
