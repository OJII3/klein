{
  "type": "object",
  "required": ["version", "llm", "runtime", "discord", "features"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "llm": {
      "type": "object",
      "required": ["provider", "model"],
      "properties": {
        "provider": {
          "type": "string",
          "const": "opencode-go"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "thinkingLevel": {
          "anyOf": [
            {
              "type": "string",
              "const": "off"
            },
            {
              "type": "string",
              "const": "minimal"
            },
            {
              "type": "string",
              "const": "low"
            },
            {
              "type": "string",
              "const": "medium"
            },
            {
              "type": "string",
              "const": "high"
            },
            {
              "type": "string",
              "const": "xhigh"
            },
            {
              "type": "string",
              "const": "max"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["agentDir"],
      "properties": {
        "agentDir": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "discord": {
      "type": "object",
      "required": ["access"],
      "properties": {
        "access": {
          "type": "object",
          "required": ["default", "directMessages"],
          "properties": {
            "default": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "allow"
                },
                {
                  "type": "string",
                  "const": "deny"
                }
              ]
            },
            "directMessages": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "allow"
                },
                {
                  "type": "string",
                  "const": "deny"
                }
              ]
            },
            "guilds": {
              "type": "object",
              "patternProperties": {
                "^[0-9]+$": {
                  "type": "object",
                  "properties": {
                    "access": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "allow"
                        },
                        {
                          "type": "string",
                          "const": "deny"
                        }
                      ]
                    },
                    "channels": {
                      "type": "object",
                      "patternProperties": {
                        "^[0-9]+$": {
                          "type": "object",
                          "properties": {
                            "access": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "const": "allow"
                                },
                                {
                                  "type": "string",
                                  "const": "deny"
                                }
                              ]
                            },
                            "threads": {
                              "type": "object",
                              "patternProperties": {
                                "^[0-9]+$": {
                                  "type": "object",
                                  "properties": {
                                    "access": {
                                      "anyOf": [
                                        {
                                          "type": "string",
                                          "const": "allow"
                                        },
                                        {
                                          "type": "string",
                                          "const": "deny"
                                        }
                                      ]
                                    }
                                  },
                                  "additionalProperties": false
                                }
                              }
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "required": ["memory", "minecraft"],
      "properties": {
        "memory": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "minecraft": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$id": "https://github.com/OJII3/klein/blob/main/config/klein.schema.json",
  "additionalProperties": false,
  "title": "Klein configuration"
}
