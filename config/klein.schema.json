{
  "type": "object",
  "required": ["version", "llm", "runtime", "features"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "llm": {
      "type": "object",
      "required": ["provider", "model"],
      "properties": {
        "provider": {
          "type": "string",
          "const": "opencode-go"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "thinkingLevel": {
          "anyOf": [
            {
              "type": "string",
              "const": "off"
            },
            {
              "type": "string",
              "const": "minimal"
            },
            {
              "type": "string",
              "const": "low"
            },
            {
              "type": "string",
              "const": "medium"
            },
            {
              "type": "string",
              "const": "high"
            },
            {
              "type": "string",
              "const": "xhigh"
            },
            {
              "type": "string",
              "const": "max"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["agentDir"],
      "properties": {
        "agentDir": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "required": ["memory", "minecraft"],
      "properties": {
        "memory": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "minecraft": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$id": "https://github.com/OJII3/klein/blob/main/config/klein.schema.json",
  "additionalProperties": false,
  "title": "Klein configuration"
}
