{
  "type": "object",
  "required": ["version", "llm", "runtime", "discord", "features"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "llm": {
      "type": "object",
      "required": ["provider", "model"],
      "properties": {
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "const": "opencode-go"
            },
            {
              "type": "string",
              "const": "google-vertex"
            }
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "thinkingLevel": {
          "anyOf": [
            {
              "type": "string",
              "const": "off"
            },
            {
              "type": "string",
              "const": "minimal"
            },
            {
              "type": "string",
              "const": "low"
            },
            {
              "type": "string",
              "const": "medium"
            },
            {
              "type": "string",
              "const": "high"
            },
            {
              "type": "string",
              "const": "xhigh"
            },
            {
              "type": "string",
              "const": "max"
            }
          ]
        },
        "contextWindowRatio": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1
        },
        "image": {
          "type": "object",
          "required": ["provider", "model"],
          "properties": {
            "provider": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "opencode-go"
                },
                {
                  "type": "string",
                  "const": "google-vertex"
                }
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "thinkingLevel": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "off"
                },
                {
                  "type": "string",
                  "const": "minimal"
                },
                {
                  "type": "string",
                  "const": "low"
                },
                {
                  "type": "string",
                  "const": "medium"
                },
                {
                  "type": "string",
                  "const": "high"
                },
                {
                  "type": "string",
                  "const": "xhigh"
                },
                {
                  "type": "string",
                  "const": "max"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["agentDir"],
      "properties": {
        "agentDir": {
          "type": "string",
          "minLength": 1
        },
        "logDir": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "discord": {
      "type": "object",
      "required": ["access"],
      "properties": {
        "access": {
          "type": "object",
          "required": ["default", "directMessages"],
          "properties": {
            "default": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "allow"
                },
                {
                  "type": "string",
                  "const": "deny"
                }
              ]
            },
            "directMessages": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "allow"
                },
                {
                  "type": "string",
                  "const": "deny"
                }
              ]
            },
            "guilds": {
              "type": "object",
              "patternProperties": {
                "^[0-9]+$": {
                  "type": "object",
                  "properties": {
                    "access": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "allow"
                        },
                        {
                          "type": "string",
                          "const": "deny"
                        }
                      ]
                    },
                    "channels": {
                      "type": "object",
                      "patternProperties": {
                        "^[0-9]+$": {
                          "type": "object",
                          "properties": {
                            "access": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "const": "allow"
                                },
                                {
                                  "type": "string",
                                  "const": "deny"
                                }
                              ]
                            },
                            "threads": {
                              "type": "object",
                              "patternProperties": {
                                "^[0-9]+$": {
                                  "type": "object",
                                  "properties": {
                                    "access": {
                                      "anyOf": [
                                        {
                                          "type": "string",
                                          "const": "allow"
                                        },
                                        {
                                          "type": "string",
                                          "const": "deny"
                                        }
                                      ]
                                    }
                                  },
                                  "additionalProperties": false
                                }
                              }
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "required": ["memory", "minecraft"],
      "properties": {
        "memory": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "filePath": {
              "type": "string",
              "minLength": 1
            },
            "llm": {
              "type": "object",
              "required": ["provider", "model"],
              "properties": {
                "provider": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "opencode-go"
                    },
                    {
                      "type": "string",
                      "const": "google-vertex"
                    }
                  ]
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "thinkingLevel": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "off"
                    },
                    {
                      "type": "string",
                      "const": "minimal"
                    },
                    {
                      "type": "string",
                      "const": "low"
                    },
                    {
                      "type": "string",
                      "const": "medium"
                    },
                    {
                      "type": "string",
                      "const": "high"
                    },
                    {
                      "type": "string",
                      "const": "xhigh"
                    },
                    {
                      "type": "string",
                      "const": "max"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "idleSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "maxBatchAgeSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "maxBatchMessages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "additionalProperties": false
        },
        "minecraft": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "webui": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        },
        "tts": {
          "type": "object",
          "required": ["enabled", "serverUrl"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "serverUrl": {
              "type": "string",
              "minLength": 1,
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "voiceChat": {
          "type": "object",
          "required": ["enabled", "asrServerUrl"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "asrServerUrl": {
              "type": "string",
              "minLength": 1,
              "format": "uri"
            },
            "language": {
              "type": "string",
              "minLength": 1
            },
            "reactions": {
              "type": "object",
              "required": ["provider", "model", "presetsFile"],
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "presetsFile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$id": "https://github.com/OJII3/klein/blob/main/config/config.schema.json",
  "additionalProperties": false,
  "title": "Application configuration"
}
