{
  "$schema": "./klein.schema.json",
  "version": 1,
  "llm": {
    "provider": "opencode-go",
    "model": "glm-5.2",
    "thinkingLevel": "high",
    "image": {
      "provider": "opencode-go",
      "model": "deepseek-v4-flash-vision-exp"
    }
  },
  "runtime": {
    "agentDir": ".runtime/pi",
    "logDir": ".runtime/logs"
  },
  "agents": {
    "discord": {
      "systemPromptFile": "config/SOUL.md"
    }
  },
  "discord": {
    "access": {
      "default": "deny",
      "directMessages": "allow",
      "guilds": {
        "123456789012345678": {
          "access": "allow",
          "channels": {
            "234567890123456789": {
              "access": "deny",
              "threads": {
                "345678901234567890": {
                  "access": "allow"
                }
              }
            }
          }
        }
      }
    }
  },
  "features": {
    "memory": {
      "enabled": false
    },
    "minecraft": {
      "enabled": false
    },
    "webui": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 4310
    }
  }
}
