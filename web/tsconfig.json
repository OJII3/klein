{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["ES2025", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "rootDir": "..",
    "paths": {
      "@app/*": ["./../src/app/*"],
      "@agents/*": ["./../src/agents/*"],
      "@modules/*": ["./../src/modules/*"],
      "@runtime/*": ["./../src/runtime/*"],
      "@shared/*": ["./../src/shared/*"],
      "@klein/webui/*": ["./../src/modules/webui/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
