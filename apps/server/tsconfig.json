{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@app/*": ["./src/app/*"],
      "@agents/*": ["./src/agents/*"],
      "@modules/*": ["./src/modules/*"],
      "@runtime/*": ["./src/runtime/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "scripts/build.ts",
    "scripts/install-systemd-user-unit.ts",
    "scripts/systemd-user-unit.ts",
    "scripts/systemd-user-unit.test.ts"
  ]
}
