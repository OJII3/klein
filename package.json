{
  "name": "klein",
  "version": "0.1.0",
  "description": "Pi-based communication agent.",
  "license": "MIT",
  "author": "OJII3",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "bun run build:web && bun run build:server",
    "build:web": "bun run --cwd web build",
    "dev:web": "bun run --cwd web dev",
    "build:server": "bun scripts/build-server.ts",
    "inspect:context": "bun scripts/inspect-context.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "generate:config-schema": "bun scripts/generate-config-schema.ts && bun fmt config/config.schema.json",
    "start": "bun run build && bun dist/klein",
    "test": "bun test",
    "typecheck": "bun check && bun check -p web/tsconfig.json"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-codemode": "1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@elysia/static": "^1.4.12",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.28.1",
    "elysia": "^1.4.31",
    "jsonc-parser": "^3.3.1",
    "ky": "^2.2.0",
    "onnxruntime-web": "1.31.1",
    "opusscript": "^0.1.1",
    "pi-web-access": "0.47.0",
    "pino": "^10.4.0",
    "prism-media": "^1.3.5",
    "typebox": "^1.4.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "oxlint": "^1.93.0"
  },
  "packageManager": "bun@1.4.4"
}
