{
  "name": "klein",
  "private": true,
  "version": "0.1.0",
  "description": "Pi-based communication agent.",
  "license": "MIT",
  "author": "OJII3",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:web && bun run build:server",
    "build:server": "bun run --filter @klein/server build",
    "build:web": "bun run --filter @klein/web build",
    "dev:web": "bun run --filter @klein/web dev",
    "generate:config-schema": "bun apps/server/scripts/generate-config-schema.ts && bun fmt config/config.schema.json",
    "inspect:context": "bun apps/server/scripts/inspect-context.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "bun run build && bun dist/klein",
    "systemd:install": "bun apps/server/scripts/install-systemd-user-unit.ts",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007"
  },
  "packageManager": "bun@1.4.4"
}
