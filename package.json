{
  "name": "klein",
  "version": "0.1.0",
  "description": "Pi-based communication agent.",
  "license": "MIT",
  "author": "OJII3",
  "type": "module",
  "scripts": {
    "build": "bun run build:web && bun run build:server",
    "build:web": "bun scripts/build-web.ts",
    "build:server": "bun scripts/build-server.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate:config-schema": "bun scripts/generate-config-schema.ts && bunx oxfmt config/klein.schema.json",
    "start": "bun run build && bun dist/klein",
    "test": "bun test",
    "typecheck": "tsc && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@elysia/eden": "^1.4.10",
    "@elysia/static": "^1.4.11",
    "discord.js": "^14.27.0",
    "elysia": "^1.4.30",
    "ky": "^2.1.0",
    "openai": "7.18.0",
    "opusscript": "0.1.1",
    "pi-web-access": "0.28.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-json-view-lite": "^2.5.0",
    "typebox": "^1.3.19"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
