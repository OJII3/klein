{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@app/*": ["./src/app/*"],
      "@agents/*": ["./src/agents/*"],
      "@modules/*": ["./src/modules/*"],
      "@runtime/*": ["./src/runtime/*"],
      "@shared/*": ["./src/shared/*"]
    },
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["src/**/*.ts"]
}
