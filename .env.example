# Discord bot token
DISCORD_BOT_TOKEN=

# Discord application ID used to register slash commands
DISCORD_APPLICATION_ID=

# OpenCode Go API key used by Pi
OPENCODE_API_KEY=

# Gemini API key (used when provider is google)
GEMINI_API_KEY=

# Mistral API key (used when provider is mistral)
# MISTRAL_API_KEY=

# Langfuse credentials used to read Mistral spend for the activity status and to
# export Pi traces over OTLP. Set LANGFUSE_TRACING=0 to keep the usage lookup
# without sending traces.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING=0

# Optional Exa API key used by pi-web-access
# EXA_API_KEY=

# Pino log level (default: info)
# KLEIN_LOG_LEVEL=info

# Optional remotely-managed Cloudflare Tunnel token (requires the Web UI to be enabled)
# TUNNEL_TOKEN=
