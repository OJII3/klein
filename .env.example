# Discord bot token
DISCORD_BOT_TOKEN=

# Discord application ID used to register slash commands
DISCORD_APPLICATION_ID=

# OpenCode Go API key used by Pi
OPENCODE_API_KEY=

# Google Cloud Vertex AI (used when provider is google-vertex)
GOOGLE_CLOUD_API_KEY=

# OpenCode Console provider connection for Mistral (used when provider is mistral)
# MISTRAL_CONSOLE_URL=https://opencode.ai/inference/custom/conn_...

# Optional Exa API key used by pi-web-access
# EXA_API_KEY=

# Pino log level (default: info)
# KLEIN_LOG_LEVEL=info

# Optional remotely-managed Cloudflare Tunnel token (requires the Web UI to be enabled)
# TUNNEL_TOKEN=
