# Discord bot token
DISCORD_BOT_TOKEN=

# Discord application ID used to register slash commands
DISCORD_APPLICATION_ID=

# OpenCode Go API key used by Pi
OPENCODE_API_KEY=

# Google Cloud Vertex AI (used when provider is google-vertex)
GOOGLE_CLOUD_API_KEY=

# Optional Vertex AI billing usage status (requires Cloud Billing export to BigQuery)
# GOOGLE_CLOUD_BILLING_PROJECT_ID=project-id-used-to-run-bigquery-queries
# GOOGLE_CLOUD_BILLING_TABLE=billing-export-project.dataset.gcp_billing_export_v1_ACCOUNTID

# OpenAI API key used by Discord GPT-Live voice conversations
OPENAI_API_KEY=

# Optional Exa API key used by pi-web-access
# EXA_API_KEY=

# Pino log level (default: info)
# KLEIN_LOG_LEVEL=info

# Optional remotely-managed Cloudflare Tunnel token (requires the Web UI to be enabled)
# TUNNEL_TOKEN=
